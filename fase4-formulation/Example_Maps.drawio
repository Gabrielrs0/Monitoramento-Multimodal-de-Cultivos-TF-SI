        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-7" parent="vwaiCpA15SNjKdsZWWLX-29" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#6a00ff;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="110" width="200" x="530" y="210" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-12" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Funcionalidade F1: Bloqueio de início por energia insuficiente&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Goals: G1, G7 | Requisitos: R1, R2, R3&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b style=&quot;&quot;&gt;Como&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b&gt; &lt;/b&gt;controlador da missão, &lt;b&gt;q&lt;/b&gt;&lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;uero&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b&gt; &lt;/b&gt;que o SCM recuse iniciar uma missão em que a carga informada seja menor que a energia estimada e exiba um alerta na tela, &lt;b&gt;p&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;ara que&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt; a missão só comece quando puder ser concluída&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="455" x="25" y="85" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-18" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 1.1]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve estimar a energia necessária da missão e bloquear o início quando a carga informada pela bateria for menor que essa estimativa &lt;b style=&quot;&quot;&gt;(R1, R2)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="25" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-19" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font&gt;&lt;b style=&quot;&quot;&gt;Cenário 1.1.1: Tentativa de início com carga insuficiente&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;b&gt;Dado que&lt;/b&gt; a carga informada pela bateria é de 40% e a energia estimada para a missão é de 65%,&lt;br&gt;&lt;/font&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;quando &lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;o controlador da missão solicita o início da missão,&lt;br&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;então&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&amp;nbsp;o SCM recusa o início da missão&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="25" y="370" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-20" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 1.2]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve exibir um alerta de energia insuficiente na tela de supervisão do controlador quando o início for bloqueado, recalculando o início se um novo plano for fornecido &lt;b style=&quot;&quot;&gt;(R1, R3)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="285" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-21" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b&gt;Cenário 1.2.1: Exibição do alerta na tela após bloqueio&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Dado que &lt;/b&gt;a bateria informa 40% de carga e a estimativa da missão é de 65%,&lt;/div&gt;&lt;div&gt;&lt;b&gt;quando &lt;/b&gt;o controlador da missão solicita o início da missão,&lt;/div&gt;&lt;div&gt;&lt;b&gt;então &lt;/b&gt;o SCM bloqueia o início e exibe na tela de supervisão o alerta de energia insuficiente&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="190" x="285" y="370" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-22" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;[Dúvida]&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;br&gt;O alerta exibido mostra só a mensagem de bloqueio ou detalha a porcentagem da carga atual e o cálculo da estimativa?&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="535" y="200" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-23" parent="vwaiCpA15SNjKdsZWWLX-29" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="160" width="200" x="20" y="540" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-24" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;Cenário 1.1.2: Início autorizado com carga suficiente&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Dado que&lt;/b&gt; a carga informada pela bateria é de 85% e a energia estimada para a missão é de 50%,&lt;br&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;quando &lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;o controlador da missão solicita o início da missão,&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;e&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;ntão &lt;/b&gt;o SCM aprova o início da missão&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="25" y="550" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-25" parent="vwaiCpA15SNjKdsZWWLX-29" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="160" width="200" x="280" y="560" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-26" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b&gt;Cenário 1.2.2: Início liberado após envio de plano ajustado&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Dado que&lt;/b&gt; o início foi recusado por carga insuficiente,&lt;br&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;quando &lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;o controlador da missão fornece um novo plano ajustado com energia estimada em 30%,&lt;br&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;então &lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;o SCM recalcula a estimativa e aprova o início da missão&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="285" y="570" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-27" parent="vwaiCpA15SNjKdsZWWLX-29" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#2B579A,#2B579A);strokeColor=light-dark(#2B579A,#2B579A);" value="" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-28" parent="vwaiCpA15SNjKdsZWWLX-29" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#FFFCF9,#FFFCF9);" value="&lt;span dir=&quot;auto&quot; style=&quot;font-size: 11pt;&quot;&gt;&lt;b&gt;&lt;font face=&quot;Helvetica&quot;&gt;MAPA 1 — FEATURE F1: Bloqueio de Início por Energia Insuficiente&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
