          <mxGeometry height="130" width="200" x="530" y="190" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-78" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Funcionalidade F4: Controle de qualidade da coleta&lt;br&gt;Goal: G9 | Requisitos: R7, R8, R9, R10&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Como &lt;/b&gt;agrônomo,&lt;b&gt; quero que&lt;/b&gt; o SCM avalie os dados coletados e refaça a coleta até duas vezes se a qualidade for insuficiente, &lt;b&gt;para que&lt;/b&gt; os dados consolidados por alvo tenham a nitidez exigida para a gestão agrícola&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="455" x="25" y="85" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-79" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 4.1]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve avaliar a qualidade dos dados coletados segundo os critérios configurados e refazer a coleta até duas vezes se a qualidade for insuficiente&lt;b&gt; (R7, R8)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="25" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-80" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 4.1.1: Qualidade aprovada na primeira tentativa&lt;br&gt;&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;br&gt;Dado que&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt; o sensor de coleta envia os dados do alvo A2 e a nitidez atinge o critério configurado,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;quando&lt;/b&gt; o SCM avalia a qualidade da imagem,&lt;br&gt;&lt;b&gt;então &lt;/b&gt;o SCM aprova a coleta sem solicitar novas tentativas&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="190" x="25" y="368" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-81" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 4.2]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve registrar o resultado como &quot;coletado&quot; ou &quot;realizada com qualidade insuficiente&quot; e associar os dados ao alvo e ao processo de coleta &lt;b&gt;(R9, R10)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="285" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-82" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 4.2.1: Gravação de resultado aprovado associado ao alvo&lt;br&gt;&lt;br&gt;Dado que &lt;/b&gt;os dados de coleta do alvo A2 foram aprovados na avaliação de qualidade,&lt;br&gt;&lt;b&gt;quando&lt;/b&gt; o SCM finaliza o atendimento do alvo,&lt;br&gt;&lt;b&gt;então&lt;/b&gt; o SCM grava o status &quot;coletado&quot; e vincula os arquivos de imagem ao ID do alvo A2&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="190" x="285" y="368" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-83" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;[Dúvida]&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;b&gt;Quais informações do processo de coleta devem ser associadas ao alvo (ex: horário, ângulo, exposição)?&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="535" y="200" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-84" parent="vwaiCpA15SNjKdsZWWLX-70" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="200" width="200" x="20" y="560" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-85" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 4.1.2: Re-coleta com ajuste de parâmetro&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Dado que &lt;/b&gt;a primeira coleta do alvo A2 apresentou nitidez insuficiente e foram realizadas 0 re-coletas anteriores,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;quando &lt;/b&gt;a avaliação de qualidade do SCM reprova a coleta,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;então &lt;/b&gt;o SCM reajusta o parâmetro de exposição do sensor e comanda uma nova tentativa de coleta no alvo A2&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="190" x="25" y="570" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-86" parent="vwaiCpA15SNjKdsZWWLX-70" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="190" width="200" x="280" y="570" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-87" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 4.2.2: Qualidade permanece insuficiente após duas re-coletas&lt;br&gt;&lt;br&gt;Dado que &lt;/b&gt;o SCM já executou duas re-coletas no alvo A2 e os dados continuam fora do critério,&lt;br&gt;&lt;b&gt;quando&lt;/b&gt; o limite de duas novas tentativas é atingido,&lt;br&gt;&lt;b&gt;então&lt;/b&gt; o SCM grava o status explícito &quot;realizada com qualidade insuficiente&quot; e prossegue a missão&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="190" x="285" y="580" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-88" parent="vwaiCpA15SNjKdsZWWLX-70" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#2B579A,#2B579A);strokeColor=light-dark(#2B579A,#2B579A);" value="" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-89" parent="vwaiCpA15SNjKdsZWWLX-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#FFFCF9,#FFFCF9);" value="&lt;span style=&quot;font-size: 14.6667px;&quot;&gt;&lt;b&gt;MAPA 4 — FEATURE F4: Controle de Qualidade da Coleta&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-91" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="790" width="760" x="1687" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-92" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFCF9,#FFFCF9);" value="" vertex="1">
          <mxGeometry height="790" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-93" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#F0851A);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="465" x="20" y="80" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-94" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="200" x="20" y="220" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-95" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="200" x="280" y="220" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-96" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="190" width="200" x="280" y="360" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-97" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="190" width="200" x="20" y="363" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-98" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#6a00ff;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="130" width="200" x="530" y="190" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-99" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Funcionalidade F5: Retorno autônomo e retomada da missão&lt;br&gt;Goal: G4 | Requisitos: R12, R13, R14&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Como &lt;/b&gt;controlador da missão, &lt;b&gt;quero &lt;/b&gt;que o SCM interrompa a missão ao atingir o limiar de retorno seguro, volte à base e retome do ponto salvo após a recarga, &lt;b&gt;para que&lt;/b&gt; a missão seja concluída sem o robô ficar descarregado no campo&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="455" x="25" y="85" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-100" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 5.1]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve interromper a missão, registrar o estado atual e comandar o retorno autônomo à base quando a carga informada cair abaixo do limiar de retorno seguro &lt;b&gt;(R12, R13)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="25" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-101" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 5.1.1: Interrupção e retorno autônomo por carga crítica&lt;br&gt;&lt;br&gt;Dado que &lt;/b&gt;o robô está executando a missão,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;quando &lt;/b&gt;a bateria informa carga de 15%,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;então &lt;/b&gt;o SCM interrompe a navegação, grava o estado atual dos alvos e comanda o retorno autônomo à base&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="190" x="25" y="368" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-102" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 5.2]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve retomar a missão a partir do estado registrado quando a recarga da bateria na base for concluída&lt;b&gt; (R14)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="285" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-103" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 5.2.1: Retomada automática após carga completa&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dado que &lt;/b&gt;o robô está na base de recarga e existe um estado salvo com o alvo A4 pendente,&lt;br&gt;&lt;b&gt;quando &lt;/b&gt;a bateria informa a conclusão da recarga,&lt;br&gt;&lt;b&gt;então &lt;/b&gt;o SCM comanda o deslocamento do robô direto ao alvo A4 para dar continuidade à missão&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="190" x="285" y="370" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-104" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;[Dúvida]&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;b&gt;A retomada após a recarga é iniciada imediatamente ao atingir 100% de carga ou aguarda uma confirmação do controlador na tela?&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="190" x="535" y="190" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-105" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="170" width="200" x="20" y="570" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-106" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 5.1.2: Manutenção da missão com carga acima do limiar&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Dado que &lt;/b&gt;o robô está executando a missão,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;quando &lt;/b&gt;a bateria informa carga de 45%,&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;então &lt;/b&gt;o SCM mantém a execução normal da missão sem emitir comando de retorno&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="190" x="25" y="580" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-107" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="200" width="200" x="280" y="570" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-108" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 5.2.2: Permanência na base enquanto a recarga não é concluída&lt;br&gt;&lt;br&gt;Dado que &lt;/b&gt;o robô está na base de recarga e a missão possui o alvo A4 pendente,&lt;br&gt;&lt;b&gt;quando &lt;/b&gt;a bateria informa carga parcial,&lt;br&gt;&lt;b&gt;então &lt;/b&gt;o SCM mantém a missão interrompida sem emitir comandos de deslocamento&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="190" x="285" y="580" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-109" parent="vwaiCpA15SNjKdsZWWLX-91" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#2B579A,#2B579A);strokeColor=light-dark(#2B579A,#2B579A);" value="" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-110" parent="vwaiCpA15SNjKdsZWWLX-91" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#FFFCF9,#FFFCF9);" value="&lt;span style=&quot;font-size: 14.6667px;&quot;&gt;&lt;b&gt;MAPA 5 — FEATURE F5: Retorno Autônomo e Retomada da Missão&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
