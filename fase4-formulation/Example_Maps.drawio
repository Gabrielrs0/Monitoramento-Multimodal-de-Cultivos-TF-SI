        <mxCell id="vwaiCpA15SNjKdsZWWLX-51" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFCF9,#FFFCF9);" value="" vertex="1">
          <mxGeometry height="760" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-52" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#F0851A);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="465" x="20" y="80" as="geometry" />
