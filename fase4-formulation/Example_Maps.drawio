        <mxCell id="vwaiCpA15SNjKdsZWWLX-33" parent="vwaiCpA15SNjKdsZWWLX-30" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="200" x="20" y="220" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-34" parent="vwaiCpA15SNjKdsZWWLX-30" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="200" x="280" y="220" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-35" parent="vwaiCpA15SNjKdsZWWLX-30" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="160" width="200" x="280" y="360" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-36" parent="vwaiCpA15SNjKdsZWWLX-30" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="160" width="200" x="20" y="360" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-37" parent="vwaiCpA15SNjKdsZWWLX-30" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#6a00ff;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="200" x="530" y="190" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-38" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Funcionalidade F2: Navegação pela ordem do plano&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Goals: G0, G2 | Requisitos: R15, R16&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Como &lt;/b&gt;controlador da missão, &lt;b&gt;quero &lt;/b&gt;que o robô siga sozinho a ordem de visita do plano, &lt;b&gt;para que&lt;/b&gt; todos os alvos obrigatórios sejam alcançados sem a necessidade de condução manual&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="455" x="25" y="85" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-39" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 2.1]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;O SCM deve selecionar o próximo alvo obrigatório ainda sem resultado, seguindo a ordem definida no plano &lt;/font&gt;&lt;b style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;(R16&lt;/font&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="25" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-40" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b&gt;Cenário 2.1.1: Seleção do primeiro alvo ao iniciar&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;&lt;br&gt;&lt;b&gt;Dado que&lt;/b&gt; o plano de monitoramento define a ordem A1 - A2 - A3 e nenhum possui resultado registrado,&lt;br&gt;&lt;b&gt;quando &lt;/b&gt;a missão é iniciada, &lt;br&gt;&lt;b&gt;então &lt;/b&gt;o SCM seleciona o alvo A1&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="25" y="370" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-41" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 2.2]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve comandar o deslocamento até as proximidades do alvo selecionado utilizando a topologia enviada pelo drone &lt;b&gt;(R15)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="285" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-42" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 2.2.1: Deslocamento em terreno sem obstáculos&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dado que&lt;/b&gt; a topologia enviada pelo drone não exibe obstáculos entre o robô e o alvo A2, &lt;br&gt;&lt;b&gt;quando&lt;/b&gt; o SCM calcula o trajeto,&lt;br&gt;&lt;b&gt;então &lt;/b&gt;o SCM comanda o deslocamento em direção ao alvo A2&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="285" y="370" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-43" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;[Dúvida]&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;b&gt;Qual é a distância limite que o SCM considera como &quot;proximidades do alvo&quot;? O que fazer se o drone não fornecer a topologia?&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="190" x="535" y="190" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-44" parent="vwaiCpA15SNjKdsZWWLX-30" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="180" width="200" x="20" y="540" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-45" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 2.1.2: Próximo alvo pendente selecionado após interrupção&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;Dado que&lt;/b&gt; o alvo A1 está registrado como &quot;coletado&quot; e o alvo A2 também,&lt;br&gt;&lt;b&gt;quando&lt;/b&gt; o SCM seleciona o próximo alvo,&lt;br&gt;&lt;b&gt;então&lt;/b&gt; o SCM seleciona o alvo A3, sem revisar o alvo A2&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="190" x="25" y="550" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-46" parent="vwaiCpA15SNjKdsZWWLX-30" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="180" width="200" x="280" y="540" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-47" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 2.2.2: Trajeto desviando de área bloqueada informada pelo drone&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dado que&lt;/b&gt; a topologia enviada pelo drone exibe uma área alagada entre o robô e o alvo A2,&lt;br&gt;&lt;b&gt;quando &lt;/b&gt;o SCM calcula o trajeto,&lt;br&gt;&lt;b&gt;então &lt;/b&gt;o SCM comanda o deslocamento contornando a área alagada&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="190" x="285" y="550" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-48" parent="vwaiCpA15SNjKdsZWWLX-30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#2B579A,#2B579A);strokeColor=light-dark(#2B579A,#2B579A);" value="" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-49" parent="vwaiCpA15SNjKdsZWWLX-30" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#FFFCF9,#FFFCF9);" value="&lt;span style=&quot;font-size: 14.6667px;&quot;&gt;&lt;b&gt;MAPA 2 — FEATURE F2: Navegação pela Ordem do Plano&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-50" connectable="0" parent="1" style="group" value="" vertex="1">
