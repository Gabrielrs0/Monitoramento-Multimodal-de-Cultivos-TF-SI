        <mxCell id="vwaiCpA15SNjKdsZWWLX-53" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="200" x="20" y="220" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-54" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="120" width="200" x="280" y="220" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-55" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="170" width="200" x="280" y="360" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-56" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="170" width="200" x="20" y="360" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-57" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#6a00ff;fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="110" width="200" x="530" y="210" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-58" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;&quot;&gt;Funcionalidade F3: Contorno de bloqueio de acesso&lt;br&gt;&lt;/font&gt;Goal: G8 | Requisitos: R4, R5, R6&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Como&lt;/b&gt; controlador da missão, &lt;b style=&quot;&quot;&gt;quero que&lt;/b&gt; o robô contorne sozinho um bloqueio no acesso a um alvo e, se não conseguir, registre o alvo como inacessível, &lt;b style=&quot;&quot;&gt;para que&lt;/b&gt; todo alvo termine com um resultado definido sem parar a missão&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="455" x="25" y="85" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-59" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 3.1]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve comandar uma posição alternativa válida quando o sensor informar bloqueio no acesso ao alvo&lt;b&gt; (R4, R5)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="25" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-60" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 3.1.1: Acesso direto sem bloqueio&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dado que&lt;/b&gt; o sensor de obstáculo não informa bloqueio no acesso ao alvo A3,&lt;br&gt;&lt;b&gt;quando&lt;/b&gt;&amp;nbsp;o SCM verifica a acessibilidade do alvo,&lt;br&gt;&lt;b&gt;então&lt;/b&gt;&amp;nbsp;o SCM comanda o robô direto para a coleta no alvo A3.&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="190" x="25" y="370" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-61" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;&lt;b style=&quot;&quot;&gt;[Regra 3.2]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Google Sans, -apple-system, BlinkMacSystemFont, Roboto, sans-serif&quot;&gt;O SCM deve registrar o alvo como &quot;inacessível&quot; e registrar o caso quando nenhuma&amp;nbsp; outra posição for viável&lt;b&gt; (R6)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="285" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-62" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 3.2.1: Alvo totalmente bloqueado sem alternativa&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dado que&lt;/b&gt; o sensor de obstáculo informa bloqueio em todos os acessos possíveis ao alvo A3,&lt;br&gt;&lt;b&gt;quando &lt;/b&gt;o SCM constata que não tem outra posição viável,&lt;br&gt;&lt;b&gt;então&lt;/b&gt; o SCM grava o status do alvo A3 como &quot;inacessível&quot; no log da missão&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="190" x="285" y="368" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-63" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;[Dúvida]&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;b&gt;Quantas posições alternativas o SCM deve tentar antes de considerar inviável?&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="535" y="200" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-64" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="190" width="200" x="20" y="550" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-65" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 3.1.2: Desvio para posição alternativa desobstruída&lt;br&gt;&lt;br&gt;Dado que&lt;/b&gt;&amp;nbsp;o sensor informa um tronco caído no acesso norte do alvo A3 e que o acesso sul está livre,&lt;br&gt;&lt;b&gt;quando&amp;nbsp;&lt;/b&gt;o SCM identifica o bloqueio no acesso principal,&lt;br&gt;&lt;b&gt;então&lt;/b&gt;&amp;nbsp;o SCM comanda o deslocamento do robô para a posição alternativa no acesso sul&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="190" x="25" y="560" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-66" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FCF411);strokeColor=light-dark(#000000,#000000);" value="" vertex="1">
          <mxGeometry height="180" width="200" x="280" y="550" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-67" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#1F1F1F,#000000);" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;Cenário 3.2.2: Prosseguimento automático para o próximo alvo&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Dado que&lt;/b&gt; o alvo A3 foi registrado com o status &quot;inacessível&quot;,&lt;br&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;quando &lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(31, 31, 31), rgb(0, 0, 0));&quot;&gt;o SCM determina o próximo passo do plano de monitoramento,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;então &lt;/b&gt;o SCM seleciona o alvo A4 e comanda o deslocamento sem interromper a missão&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="190" x="285" y="560" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-68" parent="vwaiCpA15SNjKdsZWWLX-50" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#2B579A,#2B579A);strokeColor=light-dark(#2B579A,#2B579A);" value="" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-69" parent="vwaiCpA15SNjKdsZWWLX-50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#FFFCF9,#FFFCF9);" value="&lt;span style=&quot;font-size: 14.6667px;&quot;&gt;&lt;b&gt;MAPA 3 — FEATURE F3: Contorno de Bloqueio de Acesso&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="760" as="geometry" />
        </mxCell>
        <mxCell id="vwaiCpA15SNjKdsZWWLX-70" connectable="0" parent="1" style="group" value="" vertex="1">
